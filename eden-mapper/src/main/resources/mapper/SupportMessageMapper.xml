<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="eden.mapper.SupportMessageMapper">

    <resultMap id="BaseResultMap" type="eden.pojo.SupportMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="sender_type" property="senderType"/>
        <result column="content" property="content"/>
        <result column="is_read" property="isRead"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, session_id, sender_type, content, is_read, create_time
    </sql>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM support_message
        WHERE session_id = #{sessionId}
        ORDER BY create_time ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO support_message (session_id, sender_type, content, is_read, create_time)
        VALUES (#{sessionId}, #{senderType}, #{content}, #{isRead}, NOW())
    </insert>
</mapper>
