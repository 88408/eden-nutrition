<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="eden.mapper.SeckillOrderMapper">

    <resultMap id="BaseResultMap" type="eden.pojo.SeckillOrder">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="order_id" property="orderId"/>
        <result column="seckill_id" property="seckillId"/>
        <result column="product_id" property="productId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, order_id, seckill_id, product_id, create_time
    </sql>

    <select id="selectByUserAndSeckill" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM seckill_order
        WHERE user_id = #{userId} AND seckill_id = #{seckillId}
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO seckill_order (user_id, order_id, seckill_id, product_id, create_time)
        VALUES (#{userId}, #{orderId}, #{seckillId}, #{productId}, NOW())
    </insert>

    <delete id="deleteByOrderId">
        DELETE FROM seckill_order WHERE order_id = #{orderId}
    </delete>
</mapper>
