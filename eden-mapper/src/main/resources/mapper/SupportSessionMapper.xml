<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="eden.mapper.SupportSessionMapper">

    <resultMap id="BaseResultMap" type="eden.pojo.SupportSession">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, product_id, status, create_time, update_time
    </sql>

    <select id="selectActiveByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM support_session
        WHERE user_id = #{userId}
          AND status = 1
          <if test="productId != null">
            AND product_id = #{productId}
          </if>
          <if test="productId == null">
            AND product_id IS NULL
          </if>
        ORDER BY update_time DESC
        LIMIT 1
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM support_session
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO support_session (user_id, product_id, status, create_time, update_time)
        VALUES (#{userId}, #{productId}, #{status}, NOW(), NOW())
    </insert>

    <update id="touch">
        UPDATE support_session
        SET update_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>
